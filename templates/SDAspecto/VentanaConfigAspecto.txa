[EMBED]
EMBED %ProcedureRoutines
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 4000
PROPERTY:END
LeerClase ROUTINE
  !-- Vuelca el estado del objeto global a las variables de pantalla.
  LocIni     = GLO_SDAspecto.IniFile
  LocEsquema = GLO_SDAspecto.Esquema
  LocDiag    = GLO_SDAspecto.Diagnostico
  LocModoReq = GLO_SDAspecto.ModoRequerido
  LocFteAct  = GLO_SDAspecto.FuenteActiva
  LocFteNom  = GLO_SDAspecto.FuenteNombre
  LocFteTam  = GLO_SDAspecto.FuenteTamano
  LocFteEst  = GLO_SDAspecto.FuenteEstilo
  LocFteCol  = GLO_SDAspecto.FuenteColor
  LocFteChr  = GLO_SDAspecto.FuenteCharset
  LocFteVen  = GLO_SDAspecto.FuenteAVentana
  LocFteCtl  = GLO_SDAspecto.FuenteAControles
  LocResc    = GLO_SDAspecto.RescalarActivo
  LocRescVen = GLO_SDAspecto.RescalarVentana
  LocRecen   = GLO_SDAspecto.RecentrarVentana
  LocAltoMin = GLO_SDAspecto.AltoMinimo
  DISPLAY

EscribirClase ROUTINE
  !-- Camino inverso: de la pantalla al objeto global.
  GLO_SDAspecto.IniFile          = LocIni
  GLO_SDAspecto.Esquema          = LocEsquema
  GLO_SDAspecto.Diagnostico      = LocDiag
  GLO_SDAspecto.ModoRequerido    = LocModoReq
  GLO_SDAspecto.FuenteActiva     = LocFteAct
  GLO_SDAspecto.FuenteNombre     = LocFteNom
  GLO_SDAspecto.FuenteTamano     = LocFteTam
  GLO_SDAspecto.FuenteEstilo     = LocFteEst
  GLO_SDAspecto.FuenteColor      = LocFteCol
  GLO_SDAspecto.FuenteCharset    = LocFteChr
  GLO_SDAspecto.FuenteAVentana   = LocFteVen
  GLO_SDAspecto.FuenteAControles = LocFteCtl
  GLO_SDAspecto.RescalarActivo   = LocResc
  GLO_SDAspecto.RescalarVentana  = LocRescVen
  GLO_SDAspecto.RecentrarVentana = LocRecen
  GLO_SDAspecto.AltoMinimo = LocAltoMin

LlenarLista ROUTINE
  !-- Refleja la queue de reglas del motor en la lista de pantalla.
  FREE(ReglaQ)
  IF GLO_SDAspecto.Reglas &= NULL THEN EXIT.
  LOOP LocIdx = 1 TO RECORDS(GLO_SDAspecto.Reglas)
    GET(GLO_SDAspecto.Reglas, LocIdx)
    IF ERRORCODE() THEN CYCLE.
    CLEAR(ReglaQ)
    RQNro    = LocIdx
    RQNombre = GLO_SDAspecto.Reglas.Nombre
    RQTipos  = GLO_SDAspecto.ComaLista(GLO_SDAspecto.Reglas.Tipos)
    RQTexto  = GLO_SDAspecto.ComaLista(GLO_SDAspecto.Reglas.Texto)
    RQColor  = GLO_SDAspecto.Reglas.Background
    ADD(ReglaQ)
  END
  DISPLAY(?ListaReglas)

MostrarRegla ROUTINE
  !-- Dos GET: uno a la queue de pantalla para saber que fila se toco, otro a
  !-- la del motor por el indice real que guarda RQNro.
  GET(ReglaQ, CHOICE(?ListaReglas))
  IF ERRORCODE() THEN EXIT.
  GET(GLO_SDAspecto.Reglas, RQNro)
  IF ERRORCODE() THEN EXIT.
  LocNombre  = GLO_SDAspecto.Reglas.Nombre
  LocTipos   = GLO_SDAspecto.ComaLista(GLO_SDAspecto.Reglas.Tipos)
  LocTexto   = GLO_SDAspecto.ComaLista(GLO_SDAspecto.Reglas.Texto)
  LocPicture = GLO_SDAspecto.Reglas.Picture
  LocModoTxt = GLO_SDAspecto.Reglas.ModoTexto
  LocTestReq = GLO_SDAspecto.Reglas.TestReq
  LocTestRO  = GLO_SDAspecto.Reglas.TestReadOnly
  LocTestDis = GLO_SDAspecto.Reglas.TestDisable
  LocColor   = GLO_SDAspecto.Reglas.Background
  LocActiva  = GLO_SDAspecto.Reglas.Activa
  LocCortar  = GLO_SDAspecto.Reglas.Cortar
  ?BOXTestColor{PROP:Color} = LocColor
  ?BOXTestColor{PROP:Fill} = LocColor
  DISPLAY

GuardarRegla ROUTINE
  !-- Tipos y textos se escriben separados por coma y el motor los normaliza.
  GET(ReglaQ, CHOICE(?ListaReglas))
  IF ERRORCODE() THEN EXIT.
  GET(GLO_SDAspecto.Reglas, RQNro)
  IF ERRORCODE() THEN EXIT.
  GLO_SDAspecto.Reglas.Nombre       = LocNombre
  GLO_SDAspecto.Reglas.Tipos        = GLO_SDAspecto.PipeList(LocTipos)
  GLO_SDAspecto.Reglas.Texto        = GLO_SDAspecto.PipeList(LocTexto)
  GLO_SDAspecto.Reglas.Picture      = LocPicture
  GLO_SDAspecto.Reglas.ModoTexto    = LocModoTxt
  GLO_SDAspecto.Reglas.TestReq      = LocTestReq
  GLO_SDAspecto.Reglas.TestReadOnly = LocTestRO
  GLO_SDAspecto.Reglas.TestDisable  = LocTestDis
  GLO_SDAspecto.Reglas.Background   = LocColor
  GLO_SDAspecto.Reglas.Activa       = LocActiva
  GLO_SDAspecto.Reglas.Cortar       = LocCortar
  GLO_SDAspecto.Reglas.Acciones     = BOR(GLO_SDAspecto.Reglas.Acciones, sdAct:Color)
  PUT(GLO_SDAspecto.Reglas)

LlenarFijos ROUTINE
  FREE(FijoQ)
  FQTipo = 'LIST'   ; FQColor = GLO_SDAspecto.ColorList   ; ADD(FijoQ)
  FQTipo = 'TAB'    ; FQColor = GLO_SDAspecto.ColorTab    ; ADD(FijoQ)
  FQTipo = 'SHEET'  ; FQColor = GLO_SDAspecto.ColorSheet  ; ADD(FijoQ)
  FQTipo = 'PANEL'  ; FQColor = GLO_SDAspecto.ColorPanel  ; ADD(FijoQ)
  FQTipo = 'REGION' ; FQColor = GLO_SDAspecto.ColorRegion ; ADD(FijoQ)
  FQTipo = 'COMBO'  ; FQColor = GLO_SDAspecto.ColorCombo  ; ADD(FijoQ)
  FQTipo = 'OPTION' ; FQColor = GLO_SDAspecto.ColorOption ; ADD(FijoQ)
  FQTipo = 'SPIN'   ; FQColor = GLO_SDAspecto.ColorSpin   ; ADD(FijoQ)
  FQTipo = 'TEXT'   ; FQColor = GLO_SDAspecto.ColorText   ; ADD(FijoQ)
  DISPLAY(?ListaFijos)

MostrarFijo ROUTINE
  GET(FijoQ, CHOICE(?ListaFijos))
  IF ERRORCODE() THEN EXIT.
  LocFijoColor = FQColor
  ?BOXFijoColor{PROP:Color} = LocFijoColor
  ?BOXFijoColor{PROP:Fill} = LocFijoColor

  DISPLAY(?LocFijoColor)

GuardarFijo ROUTINE
  GET(FijoQ, CHOICE(?ListaFijos))
  IF ERRORCODE() THEN EXIT.
  CASE FQTipo
  OF 'LIST'   ; GLO_SDAspecto.ColorList   = LocFijoColor
  OF 'TAB'    ; GLO_SDAspecto.ColorTab    = LocFijoColor
  OF 'SHEET'  ; GLO_SDAspecto.ColorSheet  = LocFijoColor
  OF 'PANEL'  ; GLO_SDAspecto.ColorPanel  = LocFijoColor
  OF 'REGION' ; GLO_SDAspecto.ColorRegion = LocFijoColor
  OF 'COMBO'  ; GLO_SDAspecto.ColorCombo  = LocFijoColor
  OF 'OPTION' ; GLO_SDAspecto.ColorOption = LocFijoColor
  OF 'SPIN'   ; GLO_SDAspecto.ColorSpin   = LocFijoColor
  OF 'TEXT'   ; GLO_SDAspecto.ColorText   = LocFijoColor
  END
  DO LlenarFijos
[END]
EMBED %WindowManagerMethodCodeSection
[INSTANCES]
WHEN 'Init'
[INSTANCES]
WHEN '(),BYTE'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 8000
PROPERTY:END
DO LeerClase
DO LlenarLista
DO LlenarFijos
[END]
[END]
[END]
EMBED %ControlEventHandling
[INSTANCES]
WHEN '?ElegirFteCol'
[INSTANCES]
WHEN 'Accepted'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 8500
PROPERTY:END
IF COLORDIALOG('Color de letra', LocFteCol)
  DISPLAY(?LocFteCol)
END

[END]
[END]
WHEN '?ListaReglas'
[INSTANCES]
WHEN 'NewSelection'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 5000
PROPERTY:END
DO MostrarRegla
[END]
[END]
WHEN '?AgregarTipo'
[INSTANCES]
WHEN 'Accepted'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 8500
PROPERTY:END
      !-- Agrega el tipo elegido a la lista, si no estaba ya.
      !-- Las comas de los extremos hacen que la busqueda sea de item completo:
      !-- sin ellas, LIST daria positivo dentro de DROPLIST.
      IF LEN(CLIP(LocTipoSel))
          IF NOT INSTRING(',' & CLIP(LocTipoSel) & ',', ',' & UPPER(CLIP(LocTipos)) & ',', 1, 1)
              IF LEN(CLIP(LocTipos))
                  LocTipos = CLIP(LocTipos) & ',' & CLIP(LocTipoSel)
              ELSE
                  LocTipos = CLIP(LocTipoSel)
              END
              DISPLAY(?LocTipos)
          END
      END
[END]
[END]
WHEN '?ActualizarRegla'
[INSTANCES]
WHEN 'Accepted'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 8500
PROPERTY:END
DO GuardarRegla
DO LlenarLista

[END]
[END]
WHEN '?NuevaRegla'
[INSTANCES]
WHEN 'Accepted'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 8500
PROPERTY:END
      !-- Se agrega al FINAL, o sea que se evalua ultima y pisa a las anteriores.
      !-- Si no es lo que se quiere, moverla con Subir.
      LocIdx = GLO_SDAspecto.AddRule('NuevaRegla','ENTRY')
      IF LocIdx
          DO LlenarLista
          SELECT(?ListaReglas, LocIdx)
          DO MostrarRegla
      END
[END]
[END]
WHEN '?BorrarRegla'
[INSTANCES]
WHEN 'Accepted'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 8500
PROPERTY:END
GET(ReglaQ, CHOICE(?ListaReglas))
IF NOT ERRORCODE()
  CASE MESSAGE('Borrar la regla ' & CLIP(RQNombre) & '?','SDAspecto', |
               ICON:Question, BUTTON:Yes+BUTTON:No, BUTTON:No)
  OF BUTTON:Yes
    GET(GLO_SDAspecto.Reglas, RQNro)
    IF NOT ERRORCODE()
      DELETE(GLO_SDAspecto.Reglas)
      DO LlenarLista
    END
  END
END

[END]
[END]
WHEN '?SubirRegla'
[INSTANCES]
WHEN 'Accepted'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 8500
PROPERTY:END
      !-- Reordenar es DELETE + ADD en la posicion nueva: el buffer conserva los
      !-- valores despues del DELETE, asi que se reinserta el mismo registro.
      GET(ReglaQ, CHOICE(?ListaReglas))
      IF NOT ERRORCODE()
          LocIdx = RQNro
          IF LocIdx > 1
              GET(GLO_SDAspecto.Reglas, LocIdx)
              IF NOT ERRORCODE()
                  DELETE(GLO_SDAspecto.Reglas)
                  ADD(GLO_SDAspecto.Reglas, LocIdx - 1)
                  DO LlenarLista
                  SELECT(?ListaReglas, LocIdx - 1)
                  DO MostrarRegla
              END
          END
      END
[END]
[END]
WHEN '?BajarRegla'
[INSTANCES]
WHEN 'Accepted'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 8500
PROPERTY:END
GET(ReglaQ, CHOICE(?ListaReglas))
IF NOT ERRORCODE()
  LocIdx = RQNro
  IF LocIdx < RECORDS(GLO_SDAspecto.Reglas)
    GET(GLO_SDAspecto.Reglas, LocIdx)
    IF NOT ERRORCODE()
      DELETE(GLO_SDAspecto.Reglas)
      ADD(GLO_SDAspecto.Reglas, LocIdx + 1)
      DO LlenarLista
      SELECT(?ListaReglas, LocIdx + 1)
      DO MostrarRegla
    END
  END
END

[END]
[END]
WHEN '?RestaurarFabrica'
[INSTANCES]
WHEN 'Accepted'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 8500
PROPERTY:END
      !-- Vuelve al esquema de fabrica que arma la clase en CargarDefaults().
      !-- Queda en memoria: hay que Grabar para pasarlo al INI.
      CASE MESSAGE('Se descartan TODAS las reglas actuales|y se vuelve al esquema de fabrica.' & |
          '||Continuar?','SDAspecto', ICON:Question, BUTTON:Yes+BUTTON:No, BUTTON:No)
      OF BUTTON:Yes
          GLO_SDAspecto.CargarDefaults()
          DO LlenarLista
          MESSAGE('Esquema de fabrica cargado.||Usar Grabar para pasarlo al INI.', |
              'SDAspecto',ICON:Asterisk)
      END
[END]
[END]
WHEN '?OkButton'
[INSTANCES]
WHEN 'Accepted'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 8500
PROPERTY:END
      !-- EscribirClase va ANTES: GuardarIni serializa el objeto, no la pantalla.
      DO EscribirClase
      IF SDAspectoGuardar()
          MESSAGE('Configuracion grabada en:||' & CLIP(LocIni),'SDAspecto',ICON:Asterisk)
      ELSE
          MESSAGE('No se pudo grabar.||Revisar la ruta del INI.','SDAspecto',ICON:Exclamation)
      END
[END]
[END]
WHEN '?Recargar'
[INSTANCES]
WHEN 'Accepted'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 8500
PROPERTY:END
      CASE MESSAGE('Se descartan los cambios sin grabar.|Continuar?','SDAspecto', |
          ICON:Question, BUTTON:Yes+BUTTON:No, BUTTON:No)
      OF BUTTON:Yes
          IF SDAspectoCargar()
              DO LeerClase
              DO LlenarLista
          ELSE
              MESSAGE('No se pudo leer el INI.','SDAspecto',ICON:Exclamation)
          END
      END
[END]
[END]
WHEN '?Aplicar'
[INSTANCES]
WHEN 'Accepted'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 8500
PROPERTY:END
      !-- Aplica sobre ESTA ventana, solo para ver el efecto.
      DO EscribirClase
      SDAspectoApply()
[END]
[END]
WHEN '?CancelButton'
[INSTANCES]
WHEN 'Accepted'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 8500
PROPERTY:END
POST(EVENT:CloseWindow)
[END]
[END]
WHEN '?Button:JSColorLookup'
[INSTANCES]
WHEN 'Accepted'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 6000
PROPERTY:END
      DO GuardarRegla
      ?BOXTestColor{PROP:Color} = LocColor
      ?BOXTestColor{PROP:Fill} = LocColor
      DISPLAY(?LocColor)

[END]
[END]
WHEN '?ListaFijos'
[INSTANCES]
WHEN 'NewSelection'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 5000
PROPERTY:END
  DO MostrarFijo
[END]
[END]
WHEN '?ActualizarFijo'
[INSTANCES]
WHEN 'Accepted'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 8500
PROPERTY:END
  DO GuardarFijo
[END]
[END]
WHEN '?Button:JSColorLookup:2'
[INSTANCES]
WHEN 'Accepted'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 5000
PROPERTY:END
      DO GuardarFijo
      ?BOXFijoColor{PROP:Color} = LocFijoColor
      ?BOXFijoColor{PROP:Fill} = LocFijoColor
      DISPLAY(?LocFijoColor)

[END]
[END]
[END]
[END]
[ADDITION]
NAME JSColorTools JSColorLookupButton
[INSTANCE]
INSTANCE 1
[PROMPTS]
%JSCLColorVariable FIELD  (LocColor)
%JSCLLanguage DEFAULT  ('Castellano')
%JSCLGridQuality DEFAULT  ('Normal')
%JSCLRefresh LONG  (1)
%JSCLDisable LONG  (0)
%JSCLDoPreview LONG  (0)
%JSCLPreviewControl DEFAULT  ('')
%JSCLPreviewProp DEFAULT  ('Relleno')
[INSTANCE]
INSTANCE 3
[PROMPTS]
%JSCLColorVariable FIELD  (LocFijoColor)
%JSCLLanguage DEFAULT  ('(el global)')
%JSCLGridQuality DEFAULT  ('(por defecto)')
%JSCLRefresh LONG  (1)
%JSCLDisable LONG  (0)
%JSCLDoPreview LONG  (0)
%JSCLPreviewControl DEFAULT  ('')
%JSCLPreviewProp DEFAULT  ('Relleno')
[WINDOW]
Window  WINDOW('SDAspecto - Configuracion'),AT(,,400,291),FONT('MS Sans Serif',8,,FONT:regular), |
          CENTER,GRAY,MDI,SYSTEM
          SHEET,AT(2,2,396,268),USE(?Sheet1),#ORIG(?Sheet1),#ORDINAL(1)
            TAB('General'),USE(?Tab1),#ORIG(?Tab1),#ORDINAL(2)
              PROMPT('Esquema:'),AT(10,24),USE(?PromptEsq),TRN,#ORDINAL(3)
              ENTRY(@s40),AT(130,24,150,10),USE(LocEsquema),#ORDINAL(4)
              PROMPT('Archivo INI:'),AT(10,40),USE(?PromptIni),TRN,#ORDINAL(5)
              ENTRY(@s255),AT(130,40,250,10),USE(LocIni),#ORDINAL(6)
              PROMPT('Detectar requeridos por:'),AT(10,56),USE(?PromptReq),TRN,#ORDINAL(7)
              LIST,AT(130,56,180,10),USE(LocModoReq),DROP(5),FROM('Cualquiera de los do' & |
                's|#3|Solo atributo REQ|#1|Solo fondo del disenador|#2'),#ORDINAL(8)
              STRING('LIST y COMBO no tienen atributo REQ: se marcan por color.'),AT(130,70, |
                250,10),USE(?AvisoReq),TRN,#ORDINAL(9)
              CHECK('Modo diagnostico'),AT(130,88),USE(LocDiag),#ORDINAL(10)
              STRING('Muestra un cartel por ventana. Apagar en produccion.'),AT(130,100,250, |
                10),USE(?AvisoDiag),TRN,#ORDINAL(11)
            END
            TAB('Tipografia'),USE(?Tab2),#ORDINAL(12)
              CHECK('Aplicar tipografia'),AT(10,24),USE(LocFteAct),#ORDINAL(13)
              PROMPT('Fuente:'),AT(10,40),USE(?PromptFte),TRN,#ORDINAL(14)
              ENTRY(@s64),AT(130,40,150,10),USE(LocFteNom),#ORDINAL(15)
              PROMPT('Tamano (-1 = no cambiar):'),AT(10,54),USE(?PromptTam),TRN,#ORDINAL(16)
              SPIN(@n-3),AT(130,54,40,10),USE(LocFteTam),RANGE(-1,72),STEP(1),#ORDINAL(17)
              PROMPT('Estilo:'),AT(10,68),USE(?PromptEst),TRN,#ORDINAL(18)
              LIST,AT(130,68,150,10),USE(LocFteEst),DROP(5),FROM('No cambiar|#-1|Regula' & |
                'r|#400|Negrita|#700|Cursiva|#4096|Negrita Cursiva|#4796'),#ORDINAL(19)
              PROMPT('Color de letra (-1 = no cambiar):'),AT(10,82),USE(?PromptFteCol),TRN, |
                #ORDINAL(20)
              ENTRY(@n-14),AT(130,82,60,10),USE(LocFteCol),#ORDINAL(21)
              BUTTON('...'),AT(194,82,16,10),USE(?ElegirFteCol),#ORDINAL(22)
              PROMPT('Charset (-1 = no cambiar):'),AT(10,96),USE(?PromptChr),TRN,#ORDINAL(23)
              ENTRY(@n-14),AT(130,96,60,10),USE(LocFteChr),#ORDINAL(24)
              CHECK('Aplicar a la ventana'),AT(130,114),USE(LocFteVen),#ORDINAL(25)
              CHECK('Aplicar a los controles'),AT(130,126),USE(LocFteCtl),#ORDINAL(26)
              CHECK('Rescalar controles al cambiar la fuente'),AT(130,144),USE(LocResc),#ORDINAL(27)
              CHECK('Rescalar tambien la ventana'),AT(130,156),USE(LocRescVen),#ORDINAL(28)
              CHECK('Mantener la ventana centrada'),AT(130,168),USE(LocRecen),#ORDINAL(29)
              STRING('El rescalado incluye alto de linea y anchos de columna de las LIST.'), |
                AT(130,186,250,10),USE(?AvisoFte),TRN,#ORDINAL(30)
            END
            TAB('Fijos'),USE(?TabFijos),#ORDINAL(31)
              PROMPT('Alto minimo (0 = no forzar):'),AT(10,24),USE(?PromptAlto),TRN,#ORDINAL(32)
              SPIN(@n3),AT(150,24,40,10),USE(LocAltoMin),RANGE(0,50),STEP(1),#ORDINAL(33)
              STRING('Se aplica a ENTRY, SPIN, CHECK, COMBO, LIST y BUTTON.'),AT(10,38,300, |
                10),USE(?AvisoAlto),TRN,#ORDINAL(34)
              STRING('Color de fondo por tipo de control.  -1 o 0 = no aplicar.'),AT(10,58, |
                300,10),USE(?AvisoFijos),TRN,#ORDINAL(35)
              LIST,AT(10,72,200,120),USE(?ListaFijos),VSCROLL,FORMAT('60L(2)|M~Tipo~@s1' & |
                '2@70R(2)|M~Color~C(0)@n-11@'),FROM(FijoQ),#ORDINAL(36)
              PROMPT('Color:'),AT(220,72),USE(?PromptFijo),TRN,#ORDINAL(37)
              ENTRY(@n-14),AT(250,72,60,10),USE(LocFijoColor),#ORDINAL(38)
              BUTTON('Actualizar'),AT(220,105,70,12),USE(?ActualizarFijo),#ORDINAL(39)
              STRING('GROUP no figura: no es una superficie rellenable.'),AT(10,198,300,10), |
                USE(?AvisoGroup),TRN,#ORDINAL(40)
              BOX,AT(220,86,82,11),USE(?BOXFijoColor),COLOR(COLOR:Black),FILL(COLOR:Black), |
                LINEWIDTH(1),#ORDINAL(41)
              BUTTON,AT(315,71,12,12),USE(?Button:JSColorLookup:2),ICON('colors.ico'),FLAT, |
                SKIP,#ORIG(?Button:JSColorLookup),#SEQ(3),#ORDINAL(42)
            END
            TAB('Reglas'),USE(?Tab3),#ORDINAL(43)
              LIST,AT(6,20,388,88),USE(?ListaReglas),VSCROLL,FORMAT('24R(2)|M~#~C(0)@n4' & |
                '@70L(2)|M~Regla~@s32@100L(2)|M~Tipos~@s40@114L(2)|M~Textos~@s40@60R(2)' & |
                '|M~Color~C(0)@n-11@'),FROM(ReglaQ),#ORDINAL(44)
              BUTTON('&Agregar'),AT(281,112,54,14),USE(?NuevaRegla),LEFT,ICON('wizins.ico'), |
                #ORDINAL(45)
              BUTTON('&Borrar'),AT(339,112,54,14),USE(?BorrarRegla),LEFT,ICON('wizdel.ico'), |
                #ORDINAL(46)
              BUTTON,AT(5,112,17,12),USE(?SubirRegla),ICON('Up.ico'),FLAT,#ORDINAL(47)
              BUTTON,AT(26,112,17,12),USE(?BajarRegla),ICON('Down.ico'),FLAT,#ORDINAL(48)
              BUTTON('Restaurar valores por Defecto'),AT(254,249,136,12),USE(?RestaurarFabrica), |
                #ORDINAL(49)
              STRING('Tipos y textos separados por coma. El orden de la lista es el ord' & |
