WHEN  ('?Button:JSColorLookup') (0)
WHEN  ('?Button:JSColorLookup:2') (0)

%AIHotImg DEPEND %Control DEFAULT TIMES 0

%AIHotImgVariable DEPEND %Control DEFAULT TIMES 0

%AIHotImgIsVariable DEPEND %Control LONG TIMES 2
