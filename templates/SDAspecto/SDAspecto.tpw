      #ENABLE(%SDAUsaRegion=1)
        #PROMPT('   Color:',COLOR),%SDAColRegion,DEFAULT(00F0F0F0h)
      #ENDENABLE
      #PROMPT('COMBO, DROPCOMBO y DROPLIST',CHECK),%SDAUsaCombo,DEFAULT(0)
      #ENABLE(%SDAUsaCombo=1)
        #PROMPT('   Color:',COLOR),%SDAColCombo,DEFAULT(00FFFFFFh)
      #ENDENABLE
      #PROMPT('OPTION',CHECK),%SDAUsaOption,DEFAULT(0)
      #ENABLE(%SDAUsaOption=1)
