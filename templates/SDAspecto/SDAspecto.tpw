        #ENDENABLE
      #ENDBOXED
      #BOXED('Estilo y juego de caracteres')
        #PROMPT('Estilo:',DROP('None|Regular|Negrita|Cursiva|Negrita Cursiva')),%SDAFteEstilo,DEFAULT('None')
        #PROMPT('Juego de caracteres:',DROP('None|Default|ANSI|Europa del Este|Cirilico|Griego|Turco|Baltico|Symbol|OEM')),%SDAFteCharset,DEFAULT('None')
      #ENDBOXED
      #BOXED('Alcance')
        #PROMPT('Aplicar a la ventana',CHECK),%SDAFteAVentana,DEFAULT(1)
        #PROMPT('Aplicar a los controles',CHECK),%SDAFteAControles,DEFAULT(1)
      #ENDBOXED
      #BOXED('Rescalado')
        #PROMPT('Rescalar controles al cambiar la fuente',CHECK),%SDAResc,DEFAULT(1)
        #ENABLE(%SDAResc=1)
          #PROMPT('Rescalar tambien la ventana',CHECK),%SDARescVent,DEFAULT(1)
          #ENABLE(%SDARescVent=1)
            #PROMPT('Mantener la ventana centrada',CHECK),%SDARecentrar,DEFAULT(1)
            #DISPLAY('Al crecer, la ventana se corre hacia abajo y a la')
            #DISPLAY('derecha porque su esquina queda fija. Esto la mueve')
            #DISPLAY('la mitad de lo que crecio, asi el centro no se mueve.')
          #ENDENABLE
        #ENDENABLE
        #DISPLAY('Guarda la geometria en dialog units, aplica la fuente con')
        #DISPLAY('SETFONT, fuerza el recalculo de la unidad y reescribe los')
        #DISPLAY('mismos valores. Cada control parte de su geometria')
        #DISPLAY('original, nunca de la actual.')
        #DISPLAY('')
        #DISPLAY('Incluye el alto de linea y los anchos de columna de las')
        #DISPLAY('LIST y los COMBO.')
      #ENDBOXED
      #DISPLAY('')
      #DISPLAY('Si hay otro template manejando la tipografia, conviene dejar')
      #DISPLAY('esto apagado: dos rescalando la misma ventana se pisan.')
    #ENDENABLE
  #ENDTAB
#!-----------------------------------------------------------------------------
  #TAB('INI'),WHERE(%SDADisable=0)
    #PROMPT('Recuperar la configuracion de un archivo INI',CHECK),%SDAUsaIni,DEFAULT(1)
    #ENABLE(%SDAUsaIni=1)
      #PROMPT('Archivo:',@s255),%SDAIniFile,DEFAULT('.\SDAspecto.ini')
      #DISPLAY('Ruta relativa al ejecutable si empieza con .\')
      #DISPLAY('')
      #DISPLAY('El INI se lee DESPUES de aplicar lo configurado en este')
      #DISPLAY('template, asi que lo pisa. Si el archivo no existe, o no')
      #DISPLAY('trae alguna clave, queda lo de aca. O sea: el template es')
      #DISPLAY('el valor de fabrica y el INI es la personalizacion.')
      #DISPLAY('')
      #DISPLAY('Para la ventana de configuracion hay tres funciones')
      #DISPLAY('globales, visibles desde cualquier modulo:')
      #DISPLAY('')
      #DISPLAY('  SDAspectoCargar()   relee el INI')
      #DISPLAY('  SDAspectoGuardar()  graba el estado actual al INI')
      #DISPLAY('  SDAspectoApply()    reaplica a la ventana activa')
      #DISPLAY('')
      #DISPLAY('Los parametros se editan sobre la instancia global, por')
      #DISPLAY('ejemplo:  GLO_SDAspecto.FuenteNombre = ''Segoe UI''')
    #ENDENABLE
  #ENDTAB
