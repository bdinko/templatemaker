    #DISPLAY('')
    #BOXED('Alto minimo')
      #PROMPT('Forzar alto minimo',CHECK),%SDAUsaAlto,DEFAULT(1)
      #ENABLE(%SDAUsaAlto=1)
        #PROMPT('Alto:',SPIN(@n3,0,50,1)),%SDAAltoMin,DEFAULT(9)
        #DISPLAY('Se aplica a ENTRY, SPIN, CHECK, COMBO, LIST y BUTTON.')
      #ENDENABLE
    #ENDBOXED
    #BOXED('Color de fondo por tipo de control')
      #DISPLAY('Destildado = no se toca el color de ese tipo.')
      #DISPLAY('')
      #DISPLAY('GROUP no figura: no es una superficie rellenable. Para')
      #DISPLAY('colorear el area de un grupo, poner un PANEL o REGION detras.')
      #DISPLAY('')
      #PROMPT('LIST',CHECK),%SDAUsaList,DEFAULT(1)
      #ENABLE(%SDAUsaList=1)
        #PROMPT('   Color:',COLOR),%SDAColList,DEFAULT(00F8F8F8h)
      #ENDENABLE
      #PROMPT('TAB',CHECK),%SDAUsaTab,DEFAULT(1)
      #ENABLE(%SDAUsaTab=1)
        #PROMPT('   Color:',COLOR),%SDAColTab,DEFAULT(00D8D8D8h)
        #DISPLAY('   Requiere desactivar el estilo visual en el manifiesto')
        #DISPLAY('   de la aplicacion; si no, Windows lo ignora.')
      #ENDENABLE
      #PROMPT('SHEET',CHECK),%SDAUsaSheet,DEFAULT(0)
      #ENABLE(%SDAUsaSheet=1)
        #PROMPT('   Color:',COLOR),%SDAColSheet,DEFAULT(00F0F0F0h)
      #ENDENABLE
      #PROMPT('PANEL',CHECK),%SDAUsaPanel,DEFAULT(0)
