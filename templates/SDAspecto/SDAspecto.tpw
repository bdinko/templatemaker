      #ENDENABLE
      #PROMPT('SPIN',CHECK),%SDAUsaSpin,DEFAULT(0)
      #ENABLE(%SDAUsaSpin=1)
        #PROMPT('   Color:',COLOR),%SDAColSpin,DEFAULT(00FFFFFFh)
      #ENDENABLE
      #PROMPT('TEXT',CHECK),%SDAUsaText,DEFAULT(1)
