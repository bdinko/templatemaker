#EXTENSION(SDAspecto,'SDAspecto - Personalizacion visual de controles'),APPLICATION,DESCRIPTION('[SDAspecto] Aspecto visual - esquema ' & %SDAEsquema)
#!-----------------------------------------------------------------------------
#! Extension APPLICATION. Aplica a CADA ventana inyectando en el embed
#! per-window %WindowManagerMethodCodeSection, igual que stabbwcs.tpw
#! (SuperBrowse) - no hace falta extension local por procedure.
#!
#! Los modulos MEMBER nunca ven el tipo SDAspectoClass: solo llaman a las
#! funciones globales SDAspectoApply() / SDAspectoReset(). Esqueleto multi-DLL
#! tomado de cleansdw.tpw.
#!
#! NOTA: sin AT() en los prompts - no funcionan en Clarion 11.
#!-----------------------------------------------------------------------------
#SHEET
  #TAB('General')
    #DISPLAY('SDAspecto - Adrian E. Santarelli - SDigitales')
    #DISPLAY('Version 3.06')
    #DISPLAY('')
    #PROMPT('Nombre del esquema:',@s40),%SDAEsquema,DEFAULT('SDigitales'),REQ
    #PROMPT('Nombre de la instancia global:',@s40),%SDAObjName,DEFAULT('GLO_SDAspecto'),REQ
    #DISPLAY('IMPORTANTE en multi-DLL: este nombre tiene que ser IDENTICO en')
    #DISPLAY('todas las apps del sistema. La app duena de los globales declara')
    #DISPLAY('la instancia y la exporta; el resto declara ese mismo nombre como')
    #DISPLAY('EXTERNAL y la importa. Es una sola variable para todo el sistema.')
    #DISPLAY('Si difiere en alguna app, el linker pide un simbolo inexistente.')
    #DISPLAY('')
    #PROMPT('Deshabilitar SDAspecto por completo',CHECK),%SDADisable,DEFAULT(0)
    #PROMPT('Modo diagnostico',CHECK),%SDADiag,DEFAULT(0)
    #DISPLAY('Muestra un cartel por ventana con las reglas cargadas, los')
    #DISPLAY('botones encontrados, el texto con que se los compara y que')
    #DISPLAY('regla matcheo cada uno. Apagar en produccion.')
    #DISPLAY('')
    #DISPLAY('VENTANAS REDIMENSIONABLES O MAXIMIZADAS: si una ventana usa el')
    #DISPLAY('resizer de ABC, o tiene que arrancar maximizada, agregarle al')
    #DISPLAY('procedimiento la extension "SDAspecto - Ventana redimensionable')
    #DISPLAY('o maximizada". Va por procedimiento y no aca porque el resizer')
    #DISPLAY('es de la ventana, no de la aplicacion.')
  #ENDTAB
#!-----------------------------------------------------------------------------
