        #ENABLE(%SDAFteUsaColor=1)
          #PROMPT('Usar una variable',CHECK),%SDAFteColVar,DEFAULT(0)
          #ENABLE(%SDAFteColVar=0)
            #PROMPT('Color:',COLOR),%SDAFteColor,DEFAULT(0)
