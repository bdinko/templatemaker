<!--sample:InvoiceNo=1043-->
<!--sample:Customer=Acme Ltd-->
<!--sample:Amount=$1,250.00-->
<toast launch="action=open;invoice={InvoiceNo}">
  <visual>
    <binding template="ToastGeneric">
      <image placement="appLogoOverride" src="images\logo.png"/>
      <text hint-maxLines="2">Invoice {InvoiceNo} has been paid</text>
      <text>{Customer} paid {Amount}.</text>
      <text placement="attribution">Accounts receivable</text>
    </binding>
  </visual>
  <actions>
    <action content="Open invoice" arguments="action=open;invoice={InvoiceNo}"/>
    <action content="Send receipt" arguments="action=receipt;invoice={InvoiceNo}"/>
  </actions>
  <audio src="ms-winsoundevent:Notification.Mail"/>
</toast>
