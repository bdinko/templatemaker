NAME notifications ShowNotification
[INSTANCE]
INSTANCE 7
[PROMPTS]
%nsDesign DEFAULT  ('C:\dev\clarion12\templatemaker\examples\notifications\NotifyLab\live-progress.ntf')
%nsMode DEFAULT  ('Embed')
%nsRuntimeFile DEFAULT  ('')
%nsObject DEFAULT  ('Notifier')
%nsVars MULTI LONG  (1)
%nsVarName DEPEND %nsVars DEFAULT TIMES 1
WHEN  (1) ('Report')
%nsVarValue DEPEND %nsVars DEFAULT TIMES 1
WHEN  (1) ('''Sales 2026.xlsx''')
%nsTag DEFAULT  ('''export''')
%nsGroup DEFAULT  ('')
%nsSilent LONG  (0)
%nsIdVar FIELD  ()
[ADDITION]
NAME notifications UpdateNotification
[INSTANCE]
INSTANCE 8
[PROMPTS]
%nuTag DEFAULT  ('''export''')
%nuValue DEFAULT  ('Loc:Done / 10')
%nuStatus DEFAULT  ('CHOOSE(Loc:Done < 10, ''Writing sheets...'', ''Done'')')
%nuText DEFAULT  ('Loc:Done & '' of 10''')
%nuObject DEFAULT  ('Notifier')
[ADDITION]
NAME notifications RemoveNotification
[INSTANCE]
INSTANCE 9
[PROMPTS]
%nrWhat DEFAULT  ('All')
%nrKey DEFAULT  ('')
%nrObject DEFAULT  ('Notifier')
[EMBED]
EMBED %DataSection
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 4000
PROPERTY:END
Loc:Done             LONG                ! steps of the live progress bar (0-10)
[END]
EMBED %WindowManagerMethodCodeSection
[INSTANCES]
WHEN 'Init'
[INSTANCES]
WHEN '(),BYTE'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 8500
PROPERTY:END
  IF NOT Notifier.Enabled()
    HeardPopup('Windows notifications are turned off', 'Nothing will appear until they are on again: Settings > System > Notifications.')
  END
  0{PROP:StatusText,2} = CHOOSE(Notifier.Ready(), 'Registered with Windows as Notify Lab', 'Not registered: ' & Notifier.ErrorText())
[END]
[END]
[END]
EMBED %ControlEventHandling
[INSTANCES]
WHEN '?ShowInvoice'
[INSTANCES]
WHEN 'Accepted'
[DEFINITION]
[GROUP]
PRIORITY 4000
INSTANCE 2
[SOURCE]
PROPERTY:BEGIN
PRIORITY 6000
PROPERTY:END
    0{PROP:StatusText,2} = CHOOSE(Notifier.LastError = 0 OR Notifier.LastId > 0, 'Shown: id ' & Notifier.LastId & ', tag ' & Notifier.LastTag, Notifier.ErrorText())
[END]
[END]
WHEN '?ShowChat'
[INSTANCES]
WHEN 'Accepted'
[DEFINITION]
[GROUP]
PRIORITY 4000
INSTANCE 3
[SOURCE]
PROPERTY:BEGIN
PRIORITY 6000
PROPERTY:END
    0{PROP:StatusText,2} = CHOOSE(Notifier.LastError = 0 OR Notifier.LastId > 0, 'Shown: id ' & Notifier.LastId & ', tag ' & Notifier.LastTag, Notifier.ErrorText())
[END]
[END]
WHEN '?ShowReminder'
[INSTANCES]
WHEN 'Accepted'
[DEFINITION]
[GROUP]
PRIORITY 4000
INSTANCE 4
[SOURCE]
PROPERTY:BEGIN
PRIORITY 6000
PROPERTY:END
    0{PROP:StatusText,2} = CHOOSE(Notifier.LastError = 0 OR Notifier.LastId > 0, 'Shown: id ' & Notifier.LastId & ', tag ' & Notifier.LastTag, Notifier.ErrorText())
[END]
[END]
WHEN '?ShowHero'
[INSTANCES]
WHEN 'Accepted'
[DEFINITION]
[GROUP]
PRIORITY 4000
INSTANCE 5
[SOURCE]
PROPERTY:BEGIN
PRIORITY 6000
PROPERTY:END
    0{PROP:StatusText,2} = CHOOSE(Notifier.LastError = 0 OR Notifier.LastId > 0, 'Shown: id ' & Notifier.LastId & ', tag ' & Notifier.LastTag, Notifier.ErrorText())
[END]
[END]
WHEN '?ShowUrgent'
[INSTANCES]
WHEN 'Accepted'
[DEFINITION]
[GROUP]
PRIORITY 4000
INSTANCE 6
[SOURCE]
PROPERTY:BEGIN
PRIORITY 6000
PROPERTY:END
    0{PROP:StatusText,2} = CHOOSE(Notifier.LastError = 0 OR Notifier.LastId > 0, 'Shown: id ' & Notifier.LastId & ', tag ' & Notifier.LastTag, Notifier.ErrorText())
[END]
[END]
WHEN '?StartProgress'
[INSTANCES]
WHEN 'Accepted'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 3000
PROPERTY:END
    Loc:Done = 0
[GROUP]
PRIORITY 4000
INSTANCE 7
[SOURCE]
PROPERTY:BEGIN
PRIORITY 6000
PROPERTY:END
    0{PROP:StatusText,2} = CHOOSE(Notifier.LastError = 0 OR Notifier.LastId > 0, 'Shown: id ' & Notifier.LastId & ', tag ' & Notifier.LastTag, Notifier.ErrorText())
[END]
[END]
WHEN '?StepProgress'
[INSTANCES]
WHEN 'Accepted'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 3000
PROPERTY:END
    IF Loc:Done < 10 THEN Loc:Done += 1.
[GROUP]
PRIORITY 4000
INSTANCE 8
[SOURCE]
PROPERTY:BEGIN
PRIORITY 6000
PROPERTY:END
    0{PROP:StatusText,2} = CHOOSE(Notifier.LastError = 0 OR Notifier.LastId > 0, 'Shown: id ' & Notifier.LastId & ', tag ' & Notifier.LastTag, Notifier.ErrorText())
[END]
[END]
WHEN '?RemoveAll'
[INSTANCES]
WHEN 'Accepted'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 3000
PROPERTY:END
    Loc:Done = 0
[GROUP]
PRIORITY 4000
INSTANCE 9
[SOURCE]
PROPERTY:BEGIN
PRIORITY 6000
PROPERTY:END
    0{PROP:StatusText,2} = CHOOSE(Notifier.LastError = 0 OR Notifier.LastId > 0, 'Shown: id ' & Notifier.LastId & ', tag ' & Notifier.LastTag, Notifier.ErrorText())
[END]
[END]
[END]
EMBED %neOnAction
[INSTANCES]
WHEN '1'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 5000
PROPERTY:END
            HeardPopup('Open invoice ' & Notifier.Arg('invoice'), 'EventArgs = ' & Notifier.EventArgs)
[END]
WHEN '2'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 5000
PROPERTY:END
            HeardPopup('Send the receipt for invoice ' & Notifier.Arg('invoice'), 'EventArgs = ' & Notifier.EventArgs)
[END]
WHEN '4'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 5000
PROPERTY:END
            HeardPopup('Reply to ' & Notifier.Arg('from'), 'They typed: ' & Notifier.Input('reply'))
[END]
WHEN '8'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 5000
PROPERTY:END
            HeardPopup('Reorder alert ' & Notifier.Arg('id'), 'The red Critical button')
[END]
WHEN '10'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 5000
PROPERTY:END
            Loc:Done = 0
            Notifier.Remove('export')
            HeardPopup('Export cancelled', 'The Cancel button on the progress notification')
[END]
[END]
EMBED %neOtherAction
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 5000
PROPERTY:END
            HeardPopup('Clicked: ' & Notifier.Arg('action'), 'EventArgs = ' & Notifier.EventArgs)
[END]
EMBED %neDismissed
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 5000
PROPERTY:END
          0{PROP:StatusText,2} = 'Notification ' & Notifier.EventId & ' ' & CHOOSE(Notifier.DismissReason + 1, 'closed by the user', 'hidden by the program', 'timed out to the notification centre')
[END]
EMBED %neFailed
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 5000
PROPERTY:END
          HeardPopup('Windows did not show it', Notifier.FailText())
[END]
[END]
[WINDOW]
AppFrame APPLICATION('Notify Lab - notifications template test'),AT(,,420,240),STATUS(-1,320),FONT('Segoe UI',9),RESIZE,CENTER,MAX,SYSTEM,IMM
  MENUBAR,USE(?Menubar)
    MENU('&File'),USE(?FileMenu)
      ITEM('E&xit'),USE(?Exit),STD(STD:Close)
    END
    MENU('&Notifications'),USE(?NotifyMenu)
      ITEM('&Invoice paid  (embedded design, two buttons)'),USE(?ShowInvoice)
      ITEM('&Chat with a reply box  (embedded design)'),USE(?ShowChat)
      ITEM('&Reminder with snooze  (design file read at run time)'),USE(?ShowReminder)
      ITEM('&Announcement with a picture  (design file)'),USE(?ShowHero)
      ITEM('&Urgent alert  (design file)'),USE(?ShowUrgent)
      ITEM,SEPARATOR,USE(?Sep1)
      ITEM('Start a &live progress bar'),USE(?StartProgress)
      ITEM('&Advance the progress bar  +10%'),USE(?StepProgress),KEY(F8Key)
      ITEM,SEPARATOR,USE(?Sep2)
      ITEM('Remove &all of them'),USE(?RemoveAll)
    END
  END
 END

[END]
[PROCEDURE]
NAME HeardPopup
PROTOTYPE '(STRING pTitle, STRING pDetail)'
PARAMETERS '(STRING pTitle, STRING pDetail)'
[COMMON]
DESCRIPTION 'What a notification click delivered'
FROM ABC Window
CATEGORY 'Window'
[EMBED]
EMBED %WindowManagerMethodCodeSection
[INSTANCES]
WHEN 'Init'
[INSTANCES]
WHEN '(),BYTE'
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 8500
PROPERTY:END
  ?Title{PROP:Text} = pTitle
  ?Detail{PROP:Text} = pDetail
[END]
[END]
[END]
[END]
[WINDOW]
Window WINDOW('Notification received'),AT(,,300,96),CENTER,GRAY,SYSTEM,MODAL,FONT('Segoe UI',10)
       BOX,AT(0,0,300,4),USE(?Band),COLOR(01F6FB2H),FILL(01F6FB2H)
       STRING('Title'),AT(14,14,272,12),USE(?Title),FONT(,11,0332A1FH,FONT:bold)
       TEXT,AT(14,32,272,36),USE(?Detail),SKIP,TRN,READONLY,FONT(,,05B6878H)
       BUTTON('OK'),AT(236,74,50,16),USE(?OK),STD(STD:Close),DEFAULT
     END

[END]
