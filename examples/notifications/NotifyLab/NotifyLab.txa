WHEN  (1) ('77')
WHEN  (2) ('''Quarterly review''')
WHEN  (3) ('''Today '' & FORMAT(CLOCK() + 360000, @T1)')
WHEN  (4) ('''Room 2''')
%nsTag DEFAULT  ('''appt77''')
%nsGroup DEFAULT  ('')
%nsSilent LONG  (0)
