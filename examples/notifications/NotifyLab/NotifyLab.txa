NAME notifications ShowNotification
[INSTANCE]
INSTANCE 4
[PROMPTS]
%nsDesign DEFAULT  ('C:\dev\clarion12\templatemaker\examples\notifications\NotifyLab\reminder-with-snooze.ntf')
%nsMode DEFAULT  ('File')
%nsRuntimeFile DEFAULT  ('')
%nsObject DEFAULT  ('Notifier')
%nsVars MULTI LONG  (1, 2, 3, 4)
%nsVarName DEPEND %nsVars DEFAULT TIMES 4
WHEN  (1) ('Id')
WHEN  (2) ('Subject')
WHEN  (3) ('When')
WHEN  (4) ('Where')
