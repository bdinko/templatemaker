WHEN  (1) ('''Ana Torres''')
WHEN  (2) ('''Can you approve the March figures before 5?''')
%nsTag DEFAULT  ('''chat''')
%nsGroup DEFAULT  ('''msgs''')
%nsSilent LONG  (0)
%nsIdVar FIELD  ()
