NAME notifications ShowNotification
[INSTANCE]
INSTANCE 5
[PROMPTS]
%nsDesign DEFAULT  ('C:\dev\clarion12\templatemaker\examples\notifications\NotifyLab\announcement.ntf')
%nsMode DEFAULT  ('File')
%nsRuntimeFile DEFAULT  ('')
%nsObject DEFAULT  ('Notifier')
%nsVars MULTI LONG  (1)
%nsVarName DEPEND %nsVars DEFAULT TIMES 1
WHEN  (1) ('Version')
%nsVarValue DEPEND %nsVars DEFAULT TIMES 1
WHEN  (1) ('''4.2''')
%nsTag DEFAULT  ('''news''')
%nsGroup DEFAULT  ('')
%nsSilent LONG  (0)
