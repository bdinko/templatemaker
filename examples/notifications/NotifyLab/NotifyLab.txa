NAME notifications ShowNotification
[INSTANCE]
INSTANCE 6
[PROMPTS]
%nsDesign DEFAULT  ('C:\dev\clarion12\templatemaker\examples\notifications\NotifyLab\urgent-alert.ntf')
%nsMode DEFAULT  ('File')
%nsRuntimeFile DEFAULT  ('')
%nsObject DEFAULT  ('Notifier')
%nsVars MULTI LONG  (1, 2, 3, 4)
