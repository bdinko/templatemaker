<!--sample:Report=Ventas 2026.xlsx-->
<!--sample:progressTitle=Ventas 2026.xlsx-->
<!--sample:progressValue=0.62-->
<!--sample:progressValueString=62%-->
<!--sample:progressStatus=Escribiendo hojas...-->
<toast>
  <visual>
    <binding template="ToastGeneric">
      <image placement="appLogoOverride" src="images\logo.png"/>
      <text hint-maxLines="2">Exportando {Report}</text>
      <progress title="{progressTitle}" value="{progressValue}" valueStringOverride="{progressValueString}" status="{progressStatus}"/>
    </binding>
  </visual>
  <actions>
    <action content="Cancelar" arguments="action=cancel"/>
  </actions>
  <audio silent="true"/>
</toast>
