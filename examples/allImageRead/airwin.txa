[EMBED]
EMBED %DataSection
[DEFINITION]
[SOURCE]
PROPERTY:BEGIN
PRIORITY 4000
PROPERTY:END
Loc:Url              CSTRING(256)
Loc:B64              STRING(4096)
Loc:File             CSTRING(261)
[END]
[END]
[WINDOW]
QuickWindow WINDOW('allImageRead test'),AT(,,340,300),GRAY,SYSTEM,MAX,RESIZE,STATUS(-1)
          IMAGE,AT(8,8,320,130),USE(?Pic1),#ORDINAL(1)
          IMAGE,AT(8,150,320,130),USE(?AirCanvas),#ORIG(?AirCanvas),#SEQ(1),#ORDINAL(2)
          BUTTON('|<'),AT(8,284,14,12),USE(?AirFrmFirst),#ORIG(?AirFrmFirst),#SEQ(4),#ORDINAL(3)
          BUTTON('<'),AT(24,284,14,12),USE(?AirFrmPrev),#ORIG(?AirFrmPrev),#SEQ(4),#ORDINAL(4)
          STRING('- / -'),AT(40,285,46,10),USE(?AirFrmText),#ORIG(?AirFrmText),#SEQ(4),CENTER,#ORDINAL(5)
          BUTTON('>'),AT(88,284,14,12),USE(?AirFrmNext),#ORIG(?AirFrmNext),#SEQ(4),#ORDINAL(6)
          BUTTON('>|'),AT(104,284,14,12),USE(?AirFrmLast),#ORIG(?AirFrmLast),#SEQ(4),#ORDINAL(7)
          BUTTON('Play'),AT(120,284,26,12),USE(?AirFrmPlay),#ORIG(?AirFrmPlay),#SEQ(4),#ORDINAL(8)
        END

[END]
