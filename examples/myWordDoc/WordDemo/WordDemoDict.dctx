<Dictionary Name="WordDemo" DctxFormat="4">
	<Table Guid="{5b1d7a20-3c41-4e8a-9a10-6f2b8c1d0e01}" Ident="1" Name="Docs" Prefix="DOC" Driver="TOPSPEED" Path="Docs.tps" Create="true" Thread="true" Bindable="true" Description="Documents">
		<Field Guid="{5b1d7a20-3c41-4e8a-9a10-6f2b8c1d0e02}" Ident="2" Name="Id" DataType="LONG" ScreenPicture="@n-14" ScreenPrompt="Id:" ReportHeading="Id">
			<WindowControl>
				<Line Text=" PROMPT(&apos;Id:&apos;),USE(?DOC:Id:Prompt)"/>
				<Line Text=" ENTRY(@n-14),USE(DOC:Id),RIGHT(1)"/>
			</WindowControl>
			<ReportControl>
				<Line Text=" STRING(@n-14),USE(DOC:Id),RIGHT(1)"/>
			</ReportControl>
